{
  "appId": "com.votrivalley.pkmsvv.lan",
  "productName": "Pokemon Chuyển sinh LAN",
  "asar": true,
  "extraMetadata": {
    "main": "desktop/lan-main.cjs"
  },
  "directories": {
    "output": "dist/lan-windows"
  },
  "files": [
    "desktop/lan-main.cjs",
    "lan-server/server.cjs",
    "package.json"
  ],
  "win": {
    "target": [
      "portable"
    ],
    "artifactName": "PKMSVV-LAN-${version}-Windows-x64.${ext}",
    "icon": "build/icon.ico"
  },
  "compression": "normal",
  "extraResources": [
    {
      "from": "dist/lan",
      "to": "lan-site",
      "filter": [
        "**/*"
      ]
    }
  ]
}
