/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/index.html
  Cache-Control: no-cache

/game/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/game/version.json
  Cache-Control: no-store, max-age=0

/version.json
  Cache-Control: no-store, max-age=0
